# ==============================================================
# HUENet 水下图像增强项目 .gitignore 配置
# ==============================================================

# ========== 【指定忽略】数据集与输出结果 ==========
# 原始数据集、参考数据集（体积大，不上传）
data/

# 单模型测试输出结果
results/

# 多模型对比实验输出目录
comparison_results/

# ========== 【可选】模型权重文件 ==========
# 如果不需要上传权重文件，删除下一行开头的 # 即可
# checkpoints/

# ========== Python 虚拟环境 ==========
venv/
env/
.venv/

# ========== Python 编译缓存与临时文件 ==========
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ========== 编辑器 / IDE 配置 ==========
.vscode/
.idea/
*.swp
*.swo

# ========== 系统临时文件 ==========
.DS_Store
Thumbs.db
*.log
*.tmp
.ipynb_checkpoints/
